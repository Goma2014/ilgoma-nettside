---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const alle = (await getCollection('nyheter')).sort((a, b) => b.data.dato.valueOf() - a.data.dato.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('nb-NO', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base tittel="Nytt og aktiviteter">
  <section class="seksjon">
    <div class="wrap">
      <h1>Nytt og aktiviteter</h1>
      <p class="ingress">Arrangementer, resultater og aktivitetsrapporter fra klubben. Følg oss også på Facebook for siste nytt.</p>
      <div class="rutenett" style="margin-top:2rem">
        {alle.map((n) => (
          <a class="kort lenkekort" href={`/nytt/${n.id}`} style="text-decoration:none;color:inherit">
            {n.data.bilde && <img src={n.data.bilde} alt="" loading="lazy" />}
            <div class="innhold"><small>{fmt(n.data.dato)}</small><h3>{n.data.tittel}</h3><p>{n.data.ingress}</p></div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
